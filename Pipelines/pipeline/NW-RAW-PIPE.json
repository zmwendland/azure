{
	"name": "NW-RAW-PIPE",
	"properties": {
		"description": "NW ",
		"activities": [
			{
				"name": "ForEach_ngi",
				"type": "ForEach",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@pipeline().parameters.cw_items",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Copy_ngi",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [
								{
									"name": "Source",
									"value": "@{item().source.path}"
								},
								{
									"name": "Destination",
									"value": "nw-raw-all//@{item().destination.fileName}"
								}
							],
							"typeProperties": {
								"source": {
									"type": "ODataSource"
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings"
									}
								},
								"enableStaging": true,
								"stagingSettings": {
									"linkedServiceName": {
										"referenceName": "NorthwindsStorage",
										"type": "LinkedServiceReference"
									},
									"path": "nw-raw-all"
								}
							},
							"inputs": [
								{
									"referenceName": "SourceDataset_ngi",
									"type": "DatasetReference",
									"parameters": {
										"cw_path": "@item().source.path"
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DestinationDataset_ngi",
									"type": "DatasetReference",
									"parameters": {
										"cw_fileName": "@item().destination.fileName"
									}
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"cw_items": {
				"type": "Array",
				"defaultValue": [
					{
						"source": {
							"path": "Alphabetical_list_of_products"
						},
						"destination": {
							"fileName": "Alphabetical_list_of_products.parquet"
						}
					},
					{
						"source": {
							"path": "Categories"
						},
						"destination": {
							"fileName": "Categories.parquet"
						}
					},
					{
						"source": {
