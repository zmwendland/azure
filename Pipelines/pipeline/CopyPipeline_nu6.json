{
	"name": "CopyPipeline_nu6",
	"properties": {
		"activities": [
			{
				"name": "ForEach_nu6",
				"type": "ForEach",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@pipeline().parameters.cw_items",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Copy_nu6",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [
								{
									"name": "Source",
									"value": "@{item().source.path}"
								},
								{
									"name": "Destination",
									"value": "nw-raw-all//@{item().destination.fileName}"
								}
							],
							"typeProperties": {
								"source": {
									"type": "ODataSource"
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".txt"
									}
								},
								"enableStaging": false,
								"validateDataConsistency": false
							},
							"inputs": [
								{
									"referenceName": "SourceDataset_nu6",
									"type": "DatasetReference",
									"parameters": {
										"cw_path": "@item().source.path"
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DestinationDataset_nu6",
									"type": "DatasetReference",
									"parameters": {
										"cw_fileName": "@item().destination.fileName"
									}
								}
							]
						}
					]
				}
			}
		],
